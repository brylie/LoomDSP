#!/bin/sh
# The shell mise runs each inline task step with (unix_default_inline_shell_args
# in mise.toml). It takes the arguments sh would take. When devtel is on, the
# step runs under scripts/devtel/devtel.py, which times it and writes a span;
# otherwise it is plain sh. See docs/dev/devtel.md.
if [ "${LOOM_DEVTEL:-}" = "0" ] || { [ -n "${CI:-}" ] && [ "${LOOM_DEVTEL:-}" != "1" ]; }; then
  exec sh "$@"
fi
devtel_py="$(dirname "$0")/../devtel.py"
if command -v python3 >/dev/null 2>&1 && [ -f "$devtel_py" ]; then
  exec python3 "$devtel_py" task -- "$@"
fi
exec sh "$@"
