// A steady patch for --fake-audio --measure-idle. The 1500 Hz tone sits on
// an FFT bin and fills four periods in a 128-frame meter reading. The XY
// scope reads a different sine so its sample positions can slide.
Patch(
    version: 1,
    metadata: Metadata(name: "Steady displays", license: "CC0-1.0"),
    modules: [
        PatchModule(id: 1, kind: "loom.math.constant@1", params: {"value": 0.251938707}, position: Some((0.0, 0.0))),
        PatchModule(id: 2, kind: "loom.osc.sine@1", position: Some((156.0, 0.0))),
        PatchModule(id: 3, kind: "loom.math.mul@1", params: {"gain": 0.5}, position: Some((360.0, 0.0))),
        PatchModule(id: 4, kind: "loom.display.meter@1", params: {"view": 1.0, "window": 0.0}, position: Some((540.0, 0.0))),
        PatchModule(id: 5, kind: "loom.display.spectrum@1", position: Some((540.0, 144.0))),
        PatchModule(id: 6, kind: "loom.io.audio-out@1", position: Some((816.0, 0.0))),
        PatchModule(id: 7, kind: "loom.osc.sine@1", position: Some((312.0, 312.0))),
        PatchModule(id: 8, kind: "loom.display.xy@1", position: Some((540.0, 312.0))),
        PatchModule(id: 9, kind: "loom.clock.transport@1", params: {"run": 0.0}, position: Some((0.0, 204.0))),
    ],
    cables: [
        PatchCable(from: (1, "out"), to: (2, "pitch")),
        PatchCable(from: (2, "out"), to: (3, "a")),
        PatchCable(from: (3, "out"), to: (4, "in")),
        PatchCable(from: (3, "out"), to: (5, "in")),
        PatchCable(from: (4, "out"), to: (6, "in")),
        PatchCable(from: (7, "out"), to: (8, "x")),
        PatchCable(from: (7, "out"), to: (8, "y")),
    ],
)
