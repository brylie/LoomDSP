// Every panel widget, with a few modulation assignments on them, for
// checking the canvas and inspector by hand. It uses the `test.` modules,
// so it loads only with --test-modules:
//
//   cargo run --release -p loom-app -- examples/dev/test-widgets.ron --test-modules
//
// Module 1 is the source: its `uni` (unipolar) and `bi` (bipolar) outputs
// both send its `level`. Module 2 is the target, with one assignment on
// each kind of control.
Patch(
    version: 1,
    metadata: Metadata(name: "Test widgets"),
    modules: [
        PatchModule(id: 1, kind: "test.panel@1", params: {"level": 1.0, "on": 1.0}),
        PatchModule(id: 2, kind: "test.panel@1", params: {"level": 0.25, "cutoff": 200.0, "steps": 3.0}),
        // The patch transport: 120 BPM, 4/4, running.
        PatchModule(id: 3, kind: "loom.clock.transport@1"),
        // A readout of each format, and a meter on a value around zero.
        PatchModule(id: 4, kind: "test.readout@1"),
    ],
    modulation: [
        // Knobs: a range arc on a linear, a logarithmic, and a whole-number one.
        PatchModulation(source: (1, "uni"), target: (2, "level"), depth: 0.25),
        PatchModulation(source: (1, "bi"), target: (2, "cutoff"), depth: -0.25),
        PatchModulation(source: (1, "uni"), target: (2, "steps"), depth: 0.3),
        // Faders: a range bar on a logarithmic and a linear one.
        PatchModulation(source: (1, "uni"), target: (2, "tall"), depth: 0.25),
        PatchModulation(source: (1, "bi"), target: (2, "wide"), depth: 0.25),
        // An XY pad: a bar along the bottom for `x`, and a ring at the left
        // edge for `y`, whose assignment is off.
        PatchModulation(source: (1, "uni"), target: (2, "pad_x"), depth: 0.25),
        PatchModulation(source: (1, "bi"), target: (2, "pad_y"), depth: 0.25, enabled: false),
        // A range: a bar and a live line for each handle.
        PatchModulation(source: (1, "uni"), target: (2, "span_low"), depth: 0.25),
        PatchModulation(source: (1, "bi"), target: (2, "span_high"), depth: 0.25),
        // A number shows a dot, and its text keeps the base value.
        PatchModulation(source: (1, "uni"), target: (2, "tempo"), depth: 0.25),
        // Toggle, radio, and button: the depths a drop gives them (one step).
        PatchModulation(source: (1, "uni"), target: (2, "on"), depth: 1.0),
        PatchModulation(source: (1, "bi"), target: (2, "choice"), depth: 0.5),
        PatchModulation(source: (1, "uni"), target: (2, "gate"), depth: 1.0),
        // An assignment that is off shows as a ring.
        PatchModulation(source: (1, "uni"), target: (2, "glide"), depth: 0.5, enabled: false),
    ],
)
