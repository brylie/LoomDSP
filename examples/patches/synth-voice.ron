// The built-in Synth voice (MT-SRC-08) played from MIDI Note: its
// definition is the same as crates/loom-app/library/Synth voice.ron, which
// a test checks (docs/design/sub-patches.md, Built-in abstractions).
Patch(
    version: 1,
    metadata: Metadata(
        name: "Synth voice",
        license: "CC0-1.0",
    ),
    subpatches: {
        "synth voice": SubPatch(
            metadata: Metadata(
                name: "Synth voice",
                description: "A subtractive voice with two oscillators, a filter, and two envelopes, each in a slot you can swap. Fine tune spans ±1 semitone; stack it and spread fine tune for unison.",
                authors: ["LoomDSP contributors"],
                license: "CC0-1.0",
            ),
            modules: [
                PatchModule(id: 1, kind: "loom.struct.input@1", label: Some("pitch"), position: Some((0.0, 0.0))),
                PatchModule(id: 2, kind: "loom.struct.input@1", label: Some("gate"), position: Some((0.0, 240.0))),
                PatchModule(id: 3, kind: "loom.struct.input@1", label: Some("velocity"), position: Some((0.0, 432.0))),
                PatchModule(id: 4, kind: "loom.math.constant@1", label: Some("Fine tune span"), params: {"value": 0.008333333}, position: Some((0.0, 96.0))),
                PatchModule(id: 5, kind: "loom.level.scale@1", label: Some("Fine tune"), params: {"factor": 0.0}, position: Some((144.0, 96.0))),
                PatchModule(id: 6, kind: "loom.math.add@1", label: Some("Pitch sum"), position: Some((288.0, 0.0))),
                PatchModule(id: 7, kind: "loom.osc.saw@1", position: Some((432.0, 0.0))),
                PatchModule(id: 8, kind: "loom.osc.pulse@1", params: {"octave": -1.0}, position: Some((432.0, 120.0))),
                PatchModule(id: 9, kind: "loom.mix.mixer@1", label: Some("Mixer"), params: {"level1": 0.5, "level2": 0.5}, position: Some((624.0, 0.0))),
                PatchModule(id: 10, kind: "loom.filter.svf@1", params: {"cutoff": 1200.0, "resonance": 0.3}, position: Some((816.0, 0.0))),
                PatchModule(id: 11, kind: "loom.env.envelope@1", params: {"attack": 0.005, "decay": 0.3, "sustain": 0.2, "release": 0.3}, position: Some((432.0, 240.0))),
                PatchModule(id: 12, kind: "loom.level.scale@1", label: Some("Env amount"), params: {"factor": 0.3}, position: Some((624.0, 240.0))),
                PatchModule(id: 13, kind: "loom.env.envelope@1", params: {"attack": 0.005, "decay": 0.2, "sustain": 0.7, "release": 0.3}, position: Some((432.0, 432.0))),
                PatchModule(id: 14, kind: "loom.level.amp@1", label: Some("Velocity"), position: Some((624.0, 432.0))),
                PatchModule(id: 15, kind: "loom.level.amp@1", label: Some("Amp"), params: {"gain": 0.45}, position: Some((1008.0, 0.0))),
                PatchModule(id: 16, kind: "loom.struct.output@1", label: Some("out"), position: Some((1200.0, 0.0))),
                PatchModule(id: 20, kind: "loom.struct.slot@1", label: Some("Osc 1"), slot: Some(Slot(role: "loom.role.source@1", part: Some(7))), position: Some((432.0, 0.0))),
                PatchModule(id: 21, kind: "loom.struct.slot@1", label: Some("Osc 2"), slot: Some(Slot(role: "loom.role.source@1", part: Some(8))), position: Some((432.0, 120.0))),
                PatchModule(id: 22, kind: "loom.struct.slot@1", label: Some("Filter"), slot: Some(Slot(role: "loom.role.filter@1", part: Some(10))), position: Some((816.0, 0.0))),
                PatchModule(id: 23, kind: "loom.struct.slot@1", label: Some("Mod envelope"), slot: Some(Slot(role: "loom.role.envelope@1", part: Some(11))), position: Some((432.0, 240.0))),
                PatchModule(id: 24, kind: "loom.struct.slot@1", label: Some("Amp envelope"), slot: Some(Slot(role: "loom.role.envelope@1", part: Some(13))), position: Some((432.0, 432.0))),
            ],
            cables: [
                PatchCable(from: (1, "out"), to: (6, "a")),
                PatchCable(from: (4, "out"), to: (5, "in")),
                PatchCable(from: (5, "out"), to: (6, "b")),
                PatchCable(from: (6, "out"), to: (20, "pitch")),
                PatchCable(from: (6, "out"), to: (21, "pitch")),
                PatchCable(from: (20, "out"), to: (9, "in1")),
                PatchCable(from: (21, "out"), to: (9, "in2")),
                PatchCable(from: (9, "out"), to: (22, "in")),
                PatchCable(from: (2, "out"), to: (23, "gate")),
                PatchCable(from: (23, "out"), to: (12, "in")),
                PatchCable(from: (12, "out"), to: (22, "cutoff")),
                PatchCable(from: (2, "out"), to: (24, "gate")),
                PatchCable(from: (24, "out"), to: (14, "in")),
                PatchCable(from: (3, "out"), to: (14, "level")),
                PatchCable(from: (14, "out"), to: (15, "level")),
                PatchCable(from: (22, "out"), to: (15, "in")),
                PatchCable(from: (15, "out"), to: (16, "in")),
            ],
            exposed: [
                Exposed(name: "cutoff", module: 22, param: "cutoff"),
                Exposed(name: "resonance", module: 22, param: "resonance"),
                Exposed(name: "env amount", module: 12, param: "factor", range: Some((0.0, 0.5))),
                Exposed(name: "amp attack", module: 24, param: "attack"),
                Exposed(name: "amp decay", module: 24, param: "decay"),
                Exposed(name: "amp sustain", module: 24, param: "sustain"),
                Exposed(name: "amp release", module: 24, param: "release"),
                Exposed(name: "fine tune", module: 5, param: "factor"),
                Exposed(name: "level", module: 15, param: "gain", range: Some((0.0, 1.0))),
            ],
        ),
    },
    modules: [
        PatchModule(id: 1, kind: "loom.midi.note@1", position: Some((0.0, 0.0))),
        PatchModule(id: 2, kind: "loom.struct.subpatch@1", subpatch: Some("synth voice"), position: Some((192.0, 0.0))),
        PatchModule(id: 3, kind: "loom.io.audio-out@1", position: Some((576.0, 0.0))),
        PatchModule(id: 4, kind: "loom.clock.transport@1", position: Some((0.0, 240.0))),
    ],
    cables: [
        PatchCable(from: (1, "pitch"), to: (2, "pitch")),
        PatchCable(from: (1, "gate"), to: (2, "gate")),
        PatchCable(from: (1, "velocity"), to: (2, "velocity")),
        PatchCable(from: (2, "out"), to: (3, "in")),
    ],
)
