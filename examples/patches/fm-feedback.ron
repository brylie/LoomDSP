// Feedback FM: the sine output modulates its own pitch.
// This is a cycle with no explicit delay, so the engine inserts a
// one-sample delay automatically and runs the loop one sample at a time.
// Run `loom check` on this file to see where the delay goes.
// Turn the gain up and the tone turns to noise. Why: docs/learn/feedback-fm.md
Patch(
    version: 1,
    name: "FM feedback",
    modules: [
        PatchModule(id: 1, kind: "loom.midi.note@1"),
        PatchModule(id: 2, kind: "loom.math.add@1"),
        PatchModule(id: 3, kind: "loom.phase.generator@1"),
        PatchModule(id: 4, kind: "loom.osc.sine@1"),
        // Feedback amount, in pitch units.
        PatchModule(id: 5, kind: "loom.math.mul@1", params: {"gain": 0.08}),
        PatchModule(id: 6, kind: "loom.env.adsr@1"),
        PatchModule(id: 7, kind: "loom.math.mul@1", params: {"gain": 0.3}),
        PatchModule(id: 8, kind: "loom.io.audio-out@1"),
    ],
    cables: [
        PatchCable(from: (1, "pitch"), to: (2, "a")),
        PatchCable(from: (5, "out"), to: (2, "b")),
        PatchCable(from: (2, "out"), to: (3, "pitch")),
        PatchCable(from: (3, "phase"), to: (4, "phase")),
        PatchCable(from: (4, "out"), to: (5, "a")),
        PatchCable(from: (1, "gate"), to: (6, "gate")),
        PatchCable(from: (4, "out"), to: (7, "a")),
        PatchCable(from: (6, "out"), to: (7, "b")),
        PatchCable(from: (7, "out"), to: (8, "left")),
    ],
)
