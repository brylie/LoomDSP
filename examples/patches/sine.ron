// The smallest playable instrument: a sine wave with an envelope.
// Play it with: loom play examples/patches/sine.ron
Patch(
    version: 1,
    metadata: Metadata(
        name: "Sine",
        license: "CC0-1.0",
    ),
    modules: [
        PatchModule(id: 1, kind: "loom.midi.note@1"),
        PatchModule(id: 3, kind: "loom.osc.sine@1"),
        PatchModule(id: 4, kind: "loom.env.envelope@1"),
        PatchModule(id: 5, kind: "loom.math.mul@1", params: {"gain": 0.3}),
        PatchModule(id: 6, kind: "loom.io.audio-out@1"),
        // The patch transport: 120 BPM, 4/4, running.
        PatchModule(id: 7, kind: "loom.clock.transport@1"),
    ],
    cables: [
        PatchCable(from: (1, "pitch"), to: (3, "pitch")),
        PatchCable(from: (1, "gate"), to: (4, "gate")),
        PatchCable(from: (3, "out"), to: (5, "a")),
        PatchCable(from: (4, "out"), to: (5, "b")),
        PatchCable(from: (5, "out"), to: (6, "in")),
    ],
)
