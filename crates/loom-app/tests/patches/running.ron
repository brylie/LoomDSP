// For `--frames` tests: a constant holds an envelope's gate high, feeds a
// level meter, and modulates a filter's cutoff. So a running engine lights
// the envelope's level light, fills the meter, and moves the cutoff knob's
// live dot.
Patch(
    version: 1,
    name: "Running",
    modules: [
        PatchModule(id: 1, kind: "loom.math.constant@1", params: {"value": 0.6}),
        PatchModule(id: 2, kind: "loom.env.envelope@1"),
        PatchModule(id: 3, kind: "loom.filter.svf@1"),
        PatchModule(id: 4, kind: "loom.display.meter@1"),
    ],
    cables: [
        PatchCable(from: (1, "out"), to: (2, "gate")),
        PatchCable(from: (1, "out"), to: (4, "in")),
    ],
    modulation: [
        (source: (1, "out"), target: (3, "cutoff"), depth: 0.25),
    ],
)
